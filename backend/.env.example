PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/job_portal
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Optional: create the first admin account via `npm run seed:admin`
ADMIN_NAME=Site Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me

# Optional: email notifications (application submitted/status changed/new
# applicant). If left unset, emails are logged to the console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=JobMatch AI <notifications@jobmatch.ai>

# Optional: enables an additional LLM-based semantic match score (blended
# with the local skill/text matching engine) via the Anthropic API. If
# unset, the AI matching engine runs fully locally with no external calls.
ANTHROPIC_API_KEY=
